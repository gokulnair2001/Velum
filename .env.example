# Velum Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then export before running, or use a tool like direnv / dotenv.

# ── Server ──────────────────────────────────────────────
VELUM_PORT=8080
VELUM_ENV=production          # development | staging | production

# ── Database (PostgreSQL) ───────────────────────────────
VELUM_DB_HOST=localhost       # Override postgres host (e.g. "postgres" in Docker Compose)
VELUM_DB_PASSWORD=            # REQUIRED — your PostgreSQL password

# ── Security ────────────────────────────────────────────
# SHA-256 hash of your API key (used for X-Infra-Key auth)
# Generate:  export KEY=$(openssl rand -hex 32) && echo -n "$KEY" | sha256sum
VELUM_API_KEY_HASH=           # REQUIRED when security.enabled = true

# ── AI / LLM Keys (Groq) ───────────────────────────────
# Get a key from https://console.groq.com/keys
VELUM_AI_API_KEY=             # For the AI Analyzer layer
VELUM_VOCAB_AGENT_API_KEY=    # For the Vocab Agent layer
VELUM_CONTEXT_AGENT_API_KEY=  # For the Context Agent layer
