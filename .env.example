# Velum Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Do NOT put inline comments after values.
# Docker --env-file treats everything after = as the value.

# ── Server ──────────────────────────────────────────────
VELUM_PORT=8080
# Options: development | staging | production
VELUM_ENV=production

# ── Database (PostgreSQL) ───────────────────────────────
# Set to your RDS endpoint on the server, or "postgres" in Docker Compose
VELUM_DB_HOST=localhost
VELUM_DB_USER=velum_user
VELUM_DB_PASSWORD=
VELUM_DB_NAME=velum
VELUM_DB_PORT=5432
# Options: require, disable, prefer
VELUM_DB_SSL_MODE=require

# ── Security ────────────────────────────────────────────
# SHA-256 hash of your API key (used for X-Infra-Key auth)
# Generate:  export KEY=$(openssl rand -hex 32) && echo -n "$KEY" | sha256sum
VELUM_API_KEY_HASH=

# ── AI / LLM Keys (Groq) ───────────────────────────────
# Get a key from https://console.groq.com/keys
VELUM_AI_API_KEY=
VELUM_VOCAB_AGENT_API_KEY=
VELUM_CONTEXT_AGENT_API_KEY=
